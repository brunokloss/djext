# Copy to `.env` (make install does it for you and generates SECRET_KEY) and adjust.

# Required. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Defaults to False when unset. Never True in production.
DEBUG=True

# Comma-separated. With DEBUG=True, Django already allows localhost.
ALLOWED_HOSTS=

# Comma-separated origins allowed to POST through the Next.js proxy.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Empty uses SQLite (backend/db.sqlite3), with nothing else to install. For the
# Postgres in docker-compose.yml (`make db-up`, which the other make targets run
# for you when this is set), use:
#   DATABASE_URL=postgres://djext:djext@localhost:5432/djext
DATABASE_URL=

# Seconds to keep database connections open (0 closes them after each request).
CONN_MAX_AGE=60

# The project's short name: in cookie names (_<slug>_session...), bearer keys
# (<slug>_...) and the defaults of API_TITLE and DEFAULT_FROM_EMAIL. Must match
# NEXT_PUBLIC_PROJECT_SLUG in frontend/.env, which reads the cookies.
PROJECT_SLUG=djext

# Shown in the API docs and the generated OpenAPI schema (frontend/lib/api/).
# Changing it changes the committed schema: run `make api-types` afterwards.
# Defaults to "<PROJECT_SLUG> API".
# API_TITLE=djext API

# The master key that encrypts each owner's data key (modules/crypto). In
# production an AWS KMS key, aws-kms://arn:aws:kms:<region>:<account>:key/<id>;
# in development a fake one holding the key itself (make install writes one):
#   uv run python manage.py crypto_fake_kms_uri
# Changing it makes everything encrypted so far unreadable.
CRYPTO_KMS_URI=

# The admin's URL path: /admin/ by default.
DJANGO_ADMIN_PATH=admin

# Log in with email and password. False leaves the login link and the providers
# below.
AUTH_PASSWORD=True
# Self-service accounts (modules/signup), off: djext is B2B. Sign-up with email
# verification (/signup), and a link by email to choose a new password
# (/forgot-password).
AUTH_SIGNUP=False
AUTH_PASSWORD_RESET=False
# Log in with a link sent by email instead of the password: needs
# AUTH_PASSWORD=False (one or the other).
AUTH_MAGIC_LINK=False

# Log in with a provider: each one is off while its client id is empty, and
# redirects back to <frontend>/api/auth/<provider>/callback (register that URL
# with the provider). See the README.
# https://console.cloud.google.com/apis/credentials ("Web application" client).
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# https://entra.microsoft.com, App registrations (any account type), with the
# optional ID token claim xms_edov (see modules/oauth/README.md).
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# Fake provider for development and e2e tests (`manage.py oauth_mock`, started
# by `make dev`). Only used with DEBUG=True; leave empty to hide it.
AUTH_MOCK_URL=http://localhost:8001

# Phone numbers typed without a country code are read as this country's (ISO 3166-1
# alpha-2, e.g. BR, US, PT). The admin's phone field starts on its flag.
PHONENUMBER_DEFAULT_REGION=BR

# Lowest level written to stdout: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Empty: cache in the database (no extra service). To use Redis: redis://localhost:6379/0
CACHE_URL=
# Most rows the database cache keeps (ignored with Redis); past it, the expired and then some rows are dropped.
# Django runs SELECT COUNT(*) on the cache table at every write to enforce this, and COUNT(*) is
# O(n) on Postgres: with a big table every write slows down. For heavy write loads use Redis.
CACHE_MAX_ENTRIES=100000

# Rate limits for every API endpoint, per IP while logged out and per user while
# logged in: <requests>/<period> with s, min, h or d. Empty turns one off.
API_THROTTLE_ANON=120/min
API_THROTTLE_USER=300/min
# Failed logins allowed per email and per IP; past it the login answers 429.
AUTH_LOGIN_THROTTLE_EMAIL=5/15min
AUTH_LOGIN_THROTTLE_IP=20/15min
# Emails the sign-up, the password reset and the login link send, per address
# (each on its own) and per IP.
AUTH_MAIL_THROTTLE_EMAIL=3/h
AUTH_MAIL_THROTTLE_IP=20/h

# Days to keep audit logs (0 = forever). modules/cron purges the older ones daily.
AUDIT_RETENTION_DAYS=1825

# Hours an Idempotency-Key keeps its response; modules/cron purges the older ones daily.
IDEMPOTENCY_TTL_HOURS=24

# How long a login lasts, in seconds (default 2 weeks). Expired sessions are deleted daily.
SESSION_COOKIE_AGE=1209600

# Days to keep the admin's own history (django_admin_log; 0 = forever). Purged daily.
ADMIN_LOG_RETENTION_DAYS=1825

# Days to keep finished task results and the cron's run history. Purged daily.
TASK_RESULT_RETENTION_DAYS=7

# New cron jobs start disabled until an admin turns them on (Admin › Cron). Set
# True to start them enabled. Run `manage.py db_worker` and `manage.py db_scheduler`.
CRON_AUTO_ENABLE_NEW_TASKS=False

# Empty: the worker prints each email in its console. To send for real:
# smtp://user:pass@host:587?tls=true (smtps:// for SSL; write @ in a password as %40),
# or a provider: resend://API_KEY@, postmark://TOKEN@, sendgrid://KEY@, brevo://KEY@.
EMAIL_URL=
# The "From" of every email. Defaults to "<PROJECT_SLUG> <no-reply@localhost>".
# DEFAULT_FROM_EMAIL=djext <no-reply@localhost>
# Days to keep sent emails (their text too). 0 keeps them. modules/cron deletes the older ones.
EMAIL_RETENTION_DAYS=30

# Sentry: errors and traces. Empty turns it off. With the frontend's
# NEXT_PUBLIC_SENTRY_DSN set too, a click in the browser and the error it causes
# here land in the same trace. Use the backend project's DSN.
SENTRY_DSN=
# Defaults to development with DEBUG=True, production otherwise.
SENTRY_ENVIRONMENT=
# Share of traces started here that are kept (0 to 1). Traces started in the
# browser follow the browser's decision.
SENTRY_TRACES_SAMPLE_RATE=1.0

# Where uploaded files (email attachments, for now) go. Empty: on disk, in
# backend/media/. s3://bucket for an S3 bucket (credentials from AWS_PROFILE or
# the server's role), or another S3-compatible server with its key and address.
# For the one in docker-compose.yml (`make storage`):
#   STORAGE_URL=s3://djext:djext-secret@djext?endpoint_url=http://localhost:9000
# Options in the query: region_name=sa-east-1, location=<folder>. File URLs are
# signed, expire in 5 minutes and point at the bucket; it needs CORS for the site.
STORAGE_URL=

# apps/note (the example feature): delete notes untouched for this many days (0 keeps them).
NOTE_RETENTION_DAYS=0
