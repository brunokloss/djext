# Copy to `.env` (make install does it for you) and adjust.

# Where the Django backend runs. /api is proxied to it.
BACKEND_URL=http://localhost:8000

# The Django admin's address, for the Admin link staff see in the sidebar.
# Empty: no link.
DJANGO_ADMIN_URL=http://localhost:8000/admin/

# The project's short name, which the cookie names start with: must match
# PROJECT_SLUG in backend/.env. And the name people see (title, sidebar, login
# page), which defaults to the slug. Read when the app is built: set them
# before `next build`.
NEXT_PUBLIC_PROJECT_SLUG=djext
NEXT_PUBLIC_PROJECT_NAME=

# Sentry: errors and traces, in the browser and on the Next server. Empty turns
# it off. Use the frontend project's DSN. NEXT_PUBLIC_ values are read when the
# app is built: set them before `next build`.
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to the NODE_ENV (development or production).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Share of clicks and page loads traced (0 to 1). Django follows this decision.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
# Upload source maps on `next build` (readable stack traces). SENTRY_URL only
# for a self-hosted Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_URL=

# S3 files (STORAGE_URL=s3://... in backend/.env): the browser downloads and
# uploads straight to the bucket, so the CSP allows this address (and the bucket
# needs CORS for this origin). The one Django signs for: http://localhost:9000
# for `make storage`, https://<bucket>.s3.<region>.amazonaws.com on AWS. Read
# when the app is built: set it before `next build`.
STORAGE_BUCKET_URL=
